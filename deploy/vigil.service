[Unit]
Description=Vigil Semi-Autonomous Agent Daemon
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
# Sesuaikan user dan grup dengan user non-root pada VPS Linux Anda (misal: ubuntu, debian, www-data)
User=ubuntu
Group=ubuntu

# Direktori root proyek Vigil di VPS
WorkingDirectory=/opt/vigil

# Load konfigurasi environment dari file .env
EnvironmentFile=/opt/vigil/.env

# Jalankan daemon menggunakan interpreter virtual environment
ExecStart=/opt/vigil/.venv/bin/python -m src.main

# Auto-restart otomatis jika proses berhenti tak terduga atau crash
Restart=always
RestartSec=5

# Graceful shutdown (SIGTERM diproses secara native oleh src/main.py)
KillSignal=SIGTERM
TimeoutStopSec=15

# Pengalihan log standar ke systemd journal
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
