# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ALLOWED_USER_ID=123456789

# LLM API Configuration (OpenAI Compatible / OpenRouter)
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL_NAME=meta-llama/llama-3.3-70b-instruct

# Storage & Database Configuration
DATABASE_PATH=data/vigil.db

# Engine / Heartbeat Configuration (in minutes)
HEARTBEAT_INTERVAL_MINUTES=15

# Timezone Configuration (IANA timezone name)
TIMEZONE=Asia/Jakarta

# Live Process Tracing in Telegram: true | false (default: false)
# Menampilkan progres eksekusi aksi (tool calling & reasoning) secara live di Telegram
ENABLE_PROCESS_TRACING=false

# Agent Evaluation Log for LLM Analysis: true | false (default: false)
# Log ringkas & terstruktur khusus untuk dianalisis model LLM (Hemat Token & Bebas Halusinasi)
ENABLE_EVAL_LOG=false
EVAL_LOG_PATH=logs/agent_eval.md

# Logging Level: DEBUG | INFO | WARNING | ERROR | CRITICAL
# DEBUG  -> Semua log muncul, termasuk full prompt LLM, raw response, FTS5 results, dll (untuk debugging)
# INFO   -> Operasional normal harian (default)
# WARNING -> Hanya masalah non-kritis
# ERROR  -> Hanya error
# CRITICAL -> Praktis tidak ada log
LOG_LEVEL=INFO
